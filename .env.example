# URL base de la API (MockAPI). Copia este archivo como .env.local y pon la tuya. Si queda vacío, los pedidos y mensajes solo se guardan en el navegador.
VITE_API_URL=

# Dirección de Formspree (https://formspree.io/f/xxxxxxxx) que reenvía cada pedido y mensaje al correo de la tienda. Opcional.
VITE_CORREO_URL=
